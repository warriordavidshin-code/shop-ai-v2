# shop-ai-v2 Docker environment
# Single source of truth for DB credentials: DB_NAME / DB_USER / DB_PASSWORD
# Copy to .env and adjust values. Do not commit real secrets.

COMPOSE_PROJECT_NAME=shop-ai-v2

BACKEND_IMAGE_TAG=local
FRONTEND_IMAGE_TAG=local

# --- Database (used by postgres + backend) ---
DB_NAME=shop_ai
DB_USER=shop_ai
DB_PASSWORD=shop_ai123!

POSTGRES_HOST_PORT=5432

# --- Backend ---
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_HOST_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_SECONDS=1800
JWT_REFRESH_TOKEN_SECONDS=1209600
COOKIE_SECURE=false
AI_PROVIDER=rule

# --- AI receipt / product analysis (OpenAI, paid) ---
# Put the real key only in .env / server env vars. Never commit it; it is never sent to the browser.
# Without OPENAI_API_KEY receipts still use local OCR / Gemini, and manual entry always works.
OPENAI_API_KEY=
# Vision-capable model, e.g. gpt-4.1-mini
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_RECEIPT_ENABLED=true
AI_PRODUCT_ENABLED=true
# true = return clearly labelled [MOCK] test data instead of calling OpenAI (testing only)
AI_MOCK_ENABLED=false
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_CACHE_DAYS=30
# USD per 1M tokens, used only for the estimated-cost display
AI_INPUT_PRICE_PER_MILLION=0.40
AI_OUTPUT_PRICE_PER_MILLION=1.60

# --- AI cost control (free first) ---
# FREE_FIRST: local OCR + rules -> Gemini free tier -> OpenAI only when enabled AND approved per request -> manual
# Other modes: GEMINI | OPENAI | LOCAL_ONLY | MANUAL (admin can override in 관리자 > AI 환경설정)
AI_MODE=FREE_FIRST
AI_LOCAL_OCR_ENABLED=true
AI_LOCAL_OCR_URL=http://ocr:8866
# Gemini free tier key (Google AI Studio). Server env only, never commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER=true
# Paid OpenAI stays off unless explicitly enabled; even then each call needs admin approval.
OPENAI_ENABLED=false
AI_PAID_FALLBACK_ENABLED=false
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_BUDGET_USD=1.0
AI_CACHE_ENABLED=true
# Local OCR container
OCR_CPU_THREADS=2
OCR_MEMORY_LIMIT=2g
# Upload limits (receipt/evidence files and product images)
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=60MB

# --- Social login (Kakao / Naver) ---
# Production domain: https://btc-camel.com
# Local override example: http://localhost:3000
FRONTEND_URL=https://btc-camel.com
OAUTH_PUBLIC_CALLBACK_BASE=https://btc-camel.com/api/shop
KAKAO_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Mail (password reset) ---
MAIL_ENABLED=false
MAIL_FROM=noreply@btc-camel.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Shipping (courier tracking) ---
# Put the real key only in .env / server env vars. Never commit it.
# SWEETTRACKER | GOODSFLOW | MANUAL. Without SHIPPING_API_KEY the backend falls back to MANUAL.
SHIPPING_PROVIDER=SWEETTRACKER
SHIPPING_API_KEY=
SHIPPING_CLIENT_ID=
SHIPPING_TRACKING_CACHE_MINUTES=25
SHIPPING_TRACKING_SCHEDULER_ENABLED=true
SHIPPING_TRACKING_CRON=0 */30 * * * *

# --- Frontend ---
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=3000
BACKEND_INTERNAL_URL=http://backend:8080
NEXT_PUBLIC_STORE_NAME=BoutiqueCamel
